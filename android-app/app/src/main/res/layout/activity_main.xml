<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <FrameLayout
        android:id="@+id/glassSource"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.savan.drishyam.UniversalBackgroundView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/home"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipe"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:scrollbars="none" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </FrameLayout>

            <ScrollView
                android:id="@+id/about"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="104dp"
                android:visibility="gone">
                <include
                    layout="@layout/page_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </ScrollView>
        </FrameLayout>

        <View
            android:id="@+id/edgeTop"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/home_edge_top"
            android:importantForAccessibility="no"
            android:visibility="gone" />
        <View
            android:id="@+id/edgeBottom"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_gravity="bottom"
            android:background="@drawable/home_edge_bottom"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Saved-only filter bar. The Explore header now scrolls naturally with the feed. -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.savan.drishyam.GlassLayout
            android:id="@+id/glassTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone"
            app:glassRadius="28dp">

            <LinearLayout
                android:id="@+id/savedBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">
                <TextView
                    android:id="@+id/segFav"
                    style="@style/Segment"
                    android:text="@string/seg_favourites" />
                <TextView
                    android:id="@+id/segBook"
                    style="@style/Segment"
                    android:layout_marginStart="10dp"
                    android:text="@string/seg_bookmarks" />
            </LinearLayout>
        </com.savan.drishyam.GlassLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.savan.drishyam.GlassLayout
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingStart="18dp"
                android:paddingTop="9dp"
                android:paddingEnd="18dp"
                android:paddingBottom="9dp"
                android:visibility="gone"
                app:glassRadius="100dp">
                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center"
                    android:maxWidth="300dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </com.savan.drishyam.GlassLayout>

            <com.savan.drishyam.GlassLayout
                android:id="@+id/glassNav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:padding="6dp"
                app:glassRadius="100dp">

                <View
                    android:id="@+id/navIndicator"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_gravity="top|start"
                    android:background="@drawable/accent_pill" />

                <LinearLayout
                    android:id="@+id/navItemsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/navItem0"
                        android:layout_width="68dp"
                        android:layout_height="58dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/n0"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_nav_explore"
                            android:contentDescription="@string/nav_home" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/nav_home"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/navItem1"
                        android:layout_width="68dp"
                        android:layout_height="58dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/n1"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_search"
                            android:contentDescription="@string/nav_search" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/nav_search"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/navItem2"
                        android:layout_width="68dp"
                        android:layout_height="58dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/n2"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_heart_fill"
                            android:contentDescription="@string/nav_favourites" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/nav_favourites"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/navItem3"
                        android:layout_width="68dp"
                        android:layout_height="58dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/n3"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:padding="6dp"
                            android:src="@drawable/ic_settings"
                            android:contentDescription="@string/nav_settings" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_semibold"
                            android:text="@string/nav_settings"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.savan.drishyam.GlassLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Keep the existing H2 splash and its logo hand-off intact. -->
    <include
        layout="@layout/view_launch_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>