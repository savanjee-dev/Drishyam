<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/viewerSource"
        android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView
            android:id="@+id/full"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:background="#090909"
            android:contentDescription="@string/fullscreen_desc" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/viewerOverlay"
        android:layout_width="match_parent" android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top" android:orientation="horizontal"
            android:gravity="center_vertical" android:padding="16dp">

            <com.savan.drishyam.GlassLayout
                android:id="@+id/back"
                android:layout_width="48dp" android:layout_height="48dp"
                android:clickable="true" android:focusable="true"
                app:glassDark="true" app:glassRadius="100dp">
                <ImageView
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="13dp" android:src="@drawable/ic_back"
                    android:contentDescription="@string/back_desc" />
            </com.savan.drishyam.GlassLayout>

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <com.savan.drishyam.GlassLayout
                android:id="@+id/expand"
                android:layout_width="48dp" android:layout_height="48dp"
                android:clickable="true" android:focusable="true"
                app:glassDark="true" app:glassRadius="100dp">
                <ImageView
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="13dp" android:src="@drawable/ic_expand"
                    android:contentDescription="@string/expand_desc" />
            </com.savan.drishyam.GlassLayout>

            <com.savan.drishyam.GlassLayout
                android:id="@+id/shareTop"
                android:layout_width="48dp" android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:clickable="true" android:focusable="true"
                app:glassDark="true" app:glassRadius="100dp">
                <ImageView
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="13dp" android:src="@drawable/ic_share"
                    android:contentDescription="@string/share_title" />
            </com.savan.drishyam.GlassLayout>
        </LinearLayout>

        <com.savan.drishyam.GlassLayout
            android:id="@+id/sheet"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="12dp"
            app:glassDark="true" app:glassRadius="34dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp" android:paddingEnd="22dp"
                android:paddingTop="20dp" android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/credit"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:fontFamily="@font/nothingyoucoulddo" android:textColor="#FFFFFFFF"
                    android:textSize="24sp" android:maxLines="1" android:ellipsize="end" />
                <TextView
                    android:id="@+id/published"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:fontFamily="@font/montserrat_semibold"
                    android:textColor="#B3FFFFFF" android:textSize="12sp" />
                <TextView
                    android:id="@+id/titleDetail"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:maxLines="2" android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular" android:textColor="#E6FFFFFF" android:textSize="14sp" />
                <TextView
                    android:id="@+id/meta"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:fontFamily="@font/montserrat_semibold"
                    android:textColor="#B3FFFFFF" android:textSize="12sp" />
                <TextView
                    android:id="@+id/sourceLink"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/open_source"
                    android:textColor="#FFFF9CC6" android:textSize="13sp"
                    android:clickable="true" android:focusable="true" />

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/dl"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:background="@drawable/glass_pill" android:padding="14dp"
                        android:src="@drawable/ic_download" android:contentDescription="@string/download_desc"
                        android:clickable="true" android:focusable="true" />
                    <ImageView
                        android:id="@+id/like"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/glass_pill" android:padding="13dp"
                        android:src="@drawable/ic_heart_outline"
                        android:clickable="true" android:focusable="true" />
                    <ImageView
                        android:id="@+id/bookmark"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/glass_pill" android:padding="14dp"
                        android:src="@drawable/ic_bookmark"
                        android:clickable="true" android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/setwp"
                    android:layout_width="match_parent" android:layout_height="58dp"
                    android:layout_marginTop="14dp" android:background="@drawable/accent_pill"
                    android:gravity="center" android:text="@string/set_wallpaper"
                    android:textColor="@android:color/white" android:textSize="16sp"
                    android:fontFamily="@font/poppins_medium" android:textStyle="bold"
                    android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </com.savan.drishyam.GlassLayout>
    </FrameLayout>
</FrameLayout>
