<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:fontFamily="@font/nothingyoucoulddo" android:text="@string/search_title"
        android:textColor="?attr/colorOnSurface" android:textSize="28sp" />
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/search_sub"
        android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent" android:layout_height="54dp"
        android:layout_marginTop="16dp" android:background="@drawable/glass_pill"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:hint="@string/search_hint" android:singleLine="true"
        android:textColor="?attr/colorOnSurface" android:textColorHint="?attr/colorOnSurfaceVariant" android:textSize="16sp"
        android:inputType="text" android:imeOptions="actionSearch" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="end">
        <TextView
            android:id="@+id/searchCancel"
            android:layout_width="wrap_content" android:layout_height="46dp"
            android:background="@drawable/glass_pill" android:gravity="center"
            android:paddingStart="22dp" android:paddingEnd="22dp"
            android:text="@string/cancel" android:textColor="?attr/colorOnSurface" android:textSize="15sp"
            android:fontFamily="@font/poppins_medium" android:clickable="true" android:focusable="true" />
        <TextView
            android:id="@+id/searchGo"
            android:layout_width="wrap_content" android:layout_height="46dp"
            android:layout_marginStart="10dp" android:background="@drawable/accent_pill"
            android:gravity="center" android:paddingStart="24dp" android:paddingEnd="24dp"
            android:text="@string/search_action" android:textColor="@android:color/white" android:textSize="15sp"
            android:fontFamily="@font/poppins_medium" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
