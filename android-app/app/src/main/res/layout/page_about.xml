<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="124dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
        android:orientation="vertical" android:background="@drawable/glass_card" android:padding="12dp">

        <FrameLayout
            android:layout_width="match_parent" android:layout_height="430dp"
            android:background="@drawable/glass_card" android:clipToOutline="true">

            <ImageView
                android:id="@+id/aboutBlur"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:alpha="0.28"
                android:contentDescription="@null" />

            <View
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/scrim" />

            <View
                android:id="@+id/aboutHalo"
                android:layout_width="250dp" android:layout_height="250dp"
                android:layout_gravity="center_horizontal|top" android:layout_marginTop="18dp"
                android:background="@drawable/halo" />

            <ImageView
                android:id="@+id/aboutPhoto"
                android:layout_width="224dp" android:layout_height="278dp"
                android:layout_gravity="center_horizontal|top" android:layout_marginTop="30dp"
                android:background="@drawable/glass_card" android:clipToOutline="true"
                android:scaleType="centerCrop" android:contentDescription="@string/about_name" />

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:orientation="vertical"
                android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp"
                android:paddingBottom="22dp">
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/ericaone"
                    android:text="@string/about_name" android:textColor="#FFF3F1E7" android:textSize="34sp" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:fontFamily="@font/montserrat_semibold"
                    android:letterSpacing="0.12" android:text="@string/about_role"
                    android:textColor="@color/accent2" android:textSize="10sp" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="9dp" android:fontFamily="@font/poppins_regular"
                    android:text="A photography experience shaped by curiosity."
                    android:textColor="#E6F3F1E7" android:textSize="12sp" android:gravity="center" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center"
            android:weightSum="3">
            <ImageView android:id="@+id/aboutPhoto2" android:layout_width="0dp" android:layout_height="104dp"
                android:layout_weight="1" android:layout_marginEnd="5dp" android:background="@drawable/glass_card"
                android:clipToOutline="true" android:scaleType="centerCrop" android:contentDescription="Photo of Savan and Akshat" />
            <ImageView android:id="@+id/aboutPhoto3" android:layout_width="0dp" android:layout_height="104dp"
                android:layout_weight="1" android:layout_marginHorizontal="3dp" android:background="@drawable/glass_card"
                android:clipToOutline="true" android:scaleType="centerCrop" android:contentDescription="A college friendship memory" />
            <ImageView android:id="@+id/aboutPhoto4" android:layout_width="0dp" android:layout_height="104dp"
                android:layout_weight="1" android:layout_marginStart="5dp" android:background="@drawable/glass_card"
                android:clipToOutline="true" android:scaleType="centerCrop" android:contentDescription="Another memory of the developers" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center"
            android:fontFamily="@font/montserrat_semibold" android:text="Akshat Jha · Second developer &amp; creative collaborator"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />

        <TextView
            android:id="@+id/ig"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="14dp" android:background="@drawable/accent_pill" android:gravity="center"
            android:text="@string/follow" android:textColor="#FFF3F1E7"
            android:textSize="14sp" android:fontFamily="@font/poppins_medium"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <TextView style="@style/SectionLabel" android:text="@string/about_app_title" />
    <TextView style="@style/CardText" android:text="@string/about_app_body" />

    <TextView style="@style/SectionLabel" android:text="@string/story_title" />
    <TextView style="@style/CardText" android:text="@string/story_body" />

    <TextView style="@style/SectionLabel" android:text="@string/what_title" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
        android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_semibold" android:text="@string/what_1_title"
            android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:fontFamily="@font/poppins_regular"
            android:text="@string/what_1_body" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="14dp" android:layout_marginBottom="14dp" android:background="@color/glassStroke" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_semibold" android:text="@string/what_2_title"
            android:textColor="?attr/colorOnSurface" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:fontFamily="@font/poppins_regular"
            android:text="@string/what_2_body" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
    </LinearLayout>

    <TextView style="@style/SectionLabel" android:text="@string/gallery_title" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
        android:orientation="vertical" android:background="@drawable/glass_card" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/pacifico_regular" android:text="@string/gallery_heading"
            android:textColor="?attr/colorOnSurface" android:textSize="19sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:lineSpacingExtra="3dp"
            android:fontFamily="@font/poppins_regular" android:text="@string/gallery_body"
            android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="start" android:layout_marginTop="14dp"
            android:background="@drawable/glass_pill" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="7dp" android:paddingBottom="7dp" android:text="@string/gallery_badge"
            android:textColor="?attr/colorSecondary" android:textSize="11sp" android:textStyle="bold"
            android:fontFamily="@font/montserrat_semibold" />
    </LinearLayout>

    <TextView
        android:id="@+id/footer"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:gravity="center"
        android:fontFamily="@font/montserrat_semibold" android:text="@string/footer"
        android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" />
</LinearLayout>
