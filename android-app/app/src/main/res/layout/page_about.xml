<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="18dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
        android:orientation="vertical" android:background="@drawable/glass_card" android:padding="12dp">

        <FrameLayout android:layout_width="match_parent" android:layout_height="460dp"
            android:background="@drawable/glass_card" android:clipToOutline="true">
            <ImageView android:id="@+id/aboutBlur" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:alpha="0.34" android:contentDescription="@null" />
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim" />
            <ImageView android:id="@+id/aboutPhoto" android:layout_width="250dp" android:layout_height="292dp"
                android:layout_gravity="center_horizontal|top" android:layout_marginTop="20dp"
                android:background="@drawable/glass_card" android:clipToOutline="true"
                android:scaleType="centerCrop" android:contentDescription="@string/about_name" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:orientation="vertical" android:gravity="center"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="22dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_semibold" android:letterSpacing="0.16"
                    android:text="DRISHYAM  ·  THE PEOPLE BEHIND THE FRAME"
                    android:textColor="#FFE7E4D7" android:textSize="9sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="7dp" android:fontFamily="@font/ericaone" android:text="@string/about_name"
                    android:textColor="#FFFFFFFF" android:textSize="38sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_semibold"
                    android:letterSpacing="0.10" android:text="FOUNDER &amp; LEAD DEVELOPER"
                    android:textColor="#FFD0D6B2" android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:text="TWO FRIENDS. ONE VISION."
            android:textColor="@color/accent" android:textSize="10sp" android:letterSpacing="0.14"
            android:fontFamily="@font/montserrat_semibold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:text="From a shared room to a shared vision."
            android:textColor="@color/fg" android:textSize="22sp"
            android:fontFamily="@font/montserrat_semibold" android:lineSpacingExtra="2dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Our friendship began in a college hostel. Two friends from Bihar, sharing the same room, discovered a shared passion for professional photography—and an idea to build something of our own."
            android:textColor="@color/fg" android:textSize="14sp" android:lineSpacingExtra="5dp"
            android:fontFamily="@font/poppins_regular" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="18dp"
        android:orientation="vertical" android:background="@drawable/glass_card" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="THE PEOPLE BEHIND THE IDEA" android:textColor="@color/accent"
            android:textSize="10sp" android:letterSpacing="0.12" android:fontFamily="@font/montserrat_semibold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Savan Jee"
            android:textColor="@color/fg" android:textSize="22sp" android:fontFamily="@font/montserrat_semibold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="FOUNDER &amp; LEAD DEVELOPER"
            android:textColor="@color/accent" android:textSize="10sp" android:letterSpacing="0.08"
            android:fontFamily="@font/montserrat_semibold" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginTop="15dp" android:layout_marginBottom="15dp" android:background="@color/glassStroke" />
        <ImageView android:id="@+id/aboutAkshatPhoto" android:layout_width="match_parent" android:layout_height="230dp"
            android:background="@drawable/glass_card" android:clipToOutline="true"
            android:scaleType="centerCrop" android:contentDescription="Portrait of Akshat Jha" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Akshat Jha"
            android:textColor="@color/fg" android:textSize="22sp" android:fontFamily="@font/montserrat_semibold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:text="CO-DEVELOPER"
            android:textColor="@color/accent" android:textSize="10sp" android:letterSpacing="0.08"
            android:fontFamily="@font/montserrat_semibold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="A friend and collaborator in turning a shared idea into a real project."
            android:textColor="@color/fg" android:textSize="14sp" android:lineSpacingExtra="5dp"
            android:fontFamily="@font/poppins_regular" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:layout_marginTop="26dp"
        android:text="LIFE BETWEEN THE FRAMES" android:textColor="@color/accent"
        android:textSize="10sp" android:letterSpacing="0.14" android:fontFamily="@font/montserrat_semibold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:layout_marginTop="8dp"
        android:text="Not every moment needs an explanation. Some are remembered for how they looked; others, for the people who were there."
        android:textColor="@color/fg" android:textSize="18sp" android:lineSpacingExtra="4dp"
        android:fontFamily="@font/montserrat_semibold" />

    <ImageView android:id="@+id/aboutPhoto2" android:layout_width="match_parent" android:layout_height="250dp"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="18dp"
        android:background="@drawable/glass_card" android:clipToOutline="true"
        android:scaleType="centerCrop" android:contentDescription="A shared moment from Savan and Akshat's journey" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="22dp" android:layout_marginEnd="22dp" android:layout_marginTop="8dp"
        android:text="“A familiar moment, seen a little differently.”" android:textColor="@color/accent"
        android:textSize="13sp" android:fontFamily="@font/pacifico_regular" />

    <ImageView android:id="@+id/aboutPhoto3" android:layout_width="match_parent" android:layout_height="220dp"
        android:layout_gravity="end" android:layout_marginEnd="14dp" android:layout_marginTop="22dp"
        android:background="@drawable/glass_card" android:clipToOutline="true"
        android:scaleType="centerCrop" android:contentDescription="A college friendship memory" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:layout_marginTop="8dp"
        android:text="“Some memories live quietly between the frames.”" android:textColor="@color/accent"
        android:textSize="13sp" android:fontFamily="@font/pacifico_regular" />

    <ImageView android:id="@+id/aboutPhoto4" android:layout_width="match_parent" android:layout_height="250dp"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="22dp"
        android:background="@drawable/glass_card" android:clipToOutline="true"
        android:scaleType="centerCrop" android:contentDescription="Another shared moment from the developers' journey" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="22dp" android:layout_marginEnd="22dp" android:layout_marginTop="8dp"
        android:text="“Different moments. One shared journey.”" android:textColor="@color/accent"
        android:textSize="13sp" android:fontFamily="@font/pacifico_regular" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="28dp"
        android:orientation="vertical" android:background="@drawable/glass_card" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="MORE THAN AN IMAGE" android:textColor="@color/accent" android:textSize="10sp"
            android:letterSpacing="0.14" android:fontFamily="@font/montserrat_semibold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="What if great photographs were easier to discover?"
            android:textColor="@color/fg" android:textSize="22sp" android:lineSpacingExtra="3dp"
            android:fontFamily="@font/montserrat_semibold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Our shared passion led to a simple idea: create an online platform where people could discover and enjoy high-quality photographs. That idea became Drishyam—a photography discovery and image-streaming app shaped by our interest in the art of seeing."
            android:textColor="@color/fg" android:textSize="13sp" android:lineSpacingExtra="4dp"
            android:fontFamily="@font/poppins_regular" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="26dp"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/glass_card" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:text="BUILT WITH FRIENDSHIP.\nINSPIRED BY PHOTOGRAPHY.\nCREATED TO SHARE THE VIEW."
            android:textColor="@color/fg" android:textSize="19sp" android:lineSpacingExtra="5dp"
            android:fontFamily="@font/montserrat_semibold" />
        <View android:layout_width="42dp" android:layout_height="2dp"
            android:layout_marginTop="20dp" android:layout_marginBottom="18dp" android:background="#89945A" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="AKSHAT JHA · CO-DEVELOPER" android:textColor="@color/accent"
            android:textSize="10sp" android:letterSpacing="0.08" android:fontFamily="@font/montserrat_semibold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="by Savan" android:textColor="@color/fg"
            android:textSize="32sp" android:fontFamily="@font/pacifico_regular" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="FOUNDER &amp; LEAD DEVELOPER · DRISHYAM"
            android:textColor="@color/accent" android:textSize="9sp" android:letterSpacing="0.06"
            android:fontFamily="@font/montserrat_semibold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/ig" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginTop="14dp"
        android:background="@drawable/accent_pill" android:gravity="center"
        android:orientation="horizontal" android:clickable="true" android:focusable="true"
        android:contentDescription="@string/follow">
        <ImageView android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_instagram_mono" android:tint="?attr/colorOnSurface" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="@string/follow"
            android:textColor="@color/fg" android:textSize="14sp"
            android:fontFamily="@font/poppins_medium" />
    </LinearLayout>

    <TextView android:id="@+id/footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:layout_marginBottom="8dp" android:gravity="center"
        android:fontFamily="@font/montserrat_semibold" android:text="@string/footer"
        android:textColor="@color/mute" android:textSize="11sp" />
</LinearLayout>