<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <FrameLayout
        android:id="@+id/glassSource"
        android:layout_width="match_parent" android:layout_height="match_parent">

    <com.savan.drishyam.GlowBackground
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fitsSystemWindows="true" android:fillViewport="true" android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="12dp" android:paddingBottom="80dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/settingsBack"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:background="@drawable/glass_pill" android:padding="13dp"
                    android:src="@drawable/ic_back" android:contentDescription="@string/back_desc"
                    android:clickable="true" android:focusable="true" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="14dp" android:id="@+id/settingsHeading" android:fontFamily="@font/ericaone"
                    android:text="@string/settings_title" android:textColor="?attr/colorPrimary" android:textSize="26sp" />
            </LinearLayout>

            <TextView android:id="@+id/sectionAppearance" style="@style/SectionLabel" android:text="@string/settings_appearance" />
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:id="@+id/cardTheme" android:orientation="vertical" android:background="@drawable/glass_row" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium" android:text="@string/theme_title"
                    android:textColor="?attr/colorOnSurface" android:textSize="17sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="@string/theme_desc"
                    android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <TextView android:id="@+id/themeSystem" style="@style/Segment" android:text="@string/theme_system" />
                    <TextView android:id="@+id/themeDark" style="@style/Segment"
                        android:layout_marginStart="8dp" android:text="@string/theme_dark" />
                    <TextView android:id="@+id/themeLight" style="@style/Segment"
                        android:layout_marginStart="8dp" android:text="@string/theme_light" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/sectionEffects" style="@style/SectionLabel" android:text="@string/settings_effects" />
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:id="@+id/cardHaptics" android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/glass_row" android:padding="20dp">
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium" android:text="@string/haptic_title"
                        android:textColor="?attr/colorOnSurface" android:textSize="17sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="@string/haptic_desc"
                        android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swHaptics"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:id="@+id/cardLowFx" android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/glass_row" android:padding="20dp">
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium" android:text="@string/lowfx_title"
                        android:textColor="?attr/colorOnSurface" android:textSize="17sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="@string/lowfx_desc"
                        android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swLowFx"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

            <TextView android:id="@+id/sectionFeed" style="@style/SectionLabel" android:text="@string/settings_feed" />
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:id="@+id/cardSort" android:orientation="vertical" android:background="@drawable/glass_row" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium" android:text="@string/sort_title"
                    android:textColor="?attr/colorOnSurface" android:textSize="17sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="@string/sort_desc"
                    android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <TextView android:id="@+id/sortHotS" style="@style/Segment" android:text="@string/sort_hot" />
                    <TextView android:id="@+id/sortNewS" style="@style/Segment"
                        android:layout_marginStart="8dp" android:text="@string/sort_new" />
                    <TextView android:id="@+id/sortTopS" style="@style/Segment"
                        android:layout_marginStart="8dp" android:text="@string/sort_top" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/sectionAbout" style="@style/SectionLabel" android:text="@string/settings_about" />
            <LinearLayout
                android:id="@+id/rowClear"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/glass_row" android:padding="20dp"
                android:clickable="true" android:focusable="true">
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium" android:text="@string/clear_title"
                        android:textColor="?attr/colorOnSurface" android:textSize="17sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:text="@string/clear_desc"
                        android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="26sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowWhatsNew"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/glass_row" android:padding="20dp"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium" android:text="@string/whats_new_row"
                    android:textColor="?attr/colorOnSurface" android:textSize="17sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="26sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/rowCredits"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/glass_row" android:padding="20dp"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:fontFamily="@font/poppins_medium" android:text="@string/credits_row"
                    android:textColor="?attr/colorOnSurface" android:textSize="17sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="26sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settingsVersion"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:gravity="center"
                android:fontFamily="@font/montserrat_semibold" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
    </FrameLayout>
</FrameLayout>
