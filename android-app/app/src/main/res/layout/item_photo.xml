<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardCornerRadius="26dp" app:cardElevation="0dp" app:strokeWidth="0dp"
    app:cardBackgroundColor="@color/surface">

    <FrameLayout
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/img"
            android:layout_width="match_parent" android:layout_height="280dp"
            android:scaleType="centerCrop" android:contentDescription="@string/tap_fullscreen" />

        <ImageView
            android:id="@+id/heart"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_gravity="top|end" android:layout_margin="12dp"
            android:background="@drawable/glass_media" android:padding="11dp"
            android:src="@drawable/ic_heart_outline"
            android:clickable="true" android:focusable="true"
            android:contentDescription="@string/like_desc" />

        <TextView
            android:id="@+id/lbl"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:layout_margin="12dp"
            android:background="@drawable/glass_media"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="7dp" android:paddingBottom="7dp"
            android:maxWidth="260dp" android:maxLines="1" android:ellipsize="end"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@android:color/white" android:textSize="12sp" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
