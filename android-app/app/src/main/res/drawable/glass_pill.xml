<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glassFill"/>
            <stroke android:width="1dp" android:color="@color/glassStroke"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90" android:startColor="@color/glassHighlight" android:endColor="@color/glassClear"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
</layer-list>
